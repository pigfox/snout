            "uid": "${datasource}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE continent WHEN 'AF' THEN 'Africa' WHEN 'AN' THEN 'Antarctica' WHEN 'AS' THEN 'Asia' WHEN 'EU' THEN 'Europe' WHEN 'NA' THEN 'North America' WHEN 'OC' THEN 'Oceania' WHEN 'SA' THEN 'South America' ELSE continent END AS continent, sum(users) AS users, sum(sessions) AS sessions FROM snout.daily_geo WHERE site = '$site' AND hostname = '$hostname' AND $__timeFilter(day) GROUP BY 1 ORDER BY users DESC"
