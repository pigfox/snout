          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT path, sum(views) AS views, sum(users) AS users, round(sum(avg_engagement_s * views) / nullif(sum(views), 0), 1) AS avg_engagement_s FROM snout.daily_pages WHERE site = '$site' AND hostname = '$hostname' AND $__timeFilter(day) GROUP BY path ORDER BY views DESC LIMIT 50"
