          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 1 - sum(engaged_sessions)::numeric / nullif(sum(sessions), 0) AS bounce FROM snout.daily WHERE site = '$site' AND hostname = '$hostname' AND $__timeFilter(day)"
